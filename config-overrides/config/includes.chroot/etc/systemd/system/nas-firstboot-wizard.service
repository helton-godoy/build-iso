[Unit]
Description=NAS first boot wizard (SMB/AD bootstrap)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/my-nas-firstboot/completed

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nas-firstboot-wizard.sh --auto
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
