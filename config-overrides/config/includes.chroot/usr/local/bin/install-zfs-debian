#!/usr/bin/env bash
#
# install-zfs-debian - Instalador ZFS Debian (arquitetura modular v2.0)
#
# Entry point principal que orquestra o fluxo de instalação usando
# o Design System v2.0 e módulos especializados.
#

set -euo pipefail

# ============================================================================
# CONFIGURAÇÕES GLOBAIS
# ============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib/installer"
POOL_NAME="zroot"
MOUNT_POINT="/mnt"
LOG_FILE="/var/log/installer.log"

# Variáveis do wizard
HOSTNAME=""
USERNAME=""
USER_PASS=""
ROOT_PASS=""
SELECTED_DISK=""
FIRMWARE_MODE=""

# ============================================================================
# FUNÇÕES DE UTILIDADE
# ============================================================================

log() {
  local msg="$1"
  local timestamp
  timestamp=$(date '+%Y-%m-%d %H:%M:%S')
  echo "[$timestamp] $msg" >> "$LOG_FILE"
}

error_exit() {
  local msg="$1"
  log "ERROR: $msg"
  
  if command -v gum &>/dev/null; then
    gum style --foreground "#ef4444" "✗ $msg"
  else
    echo "ERROR: $msg" >&2
  fi
  
  cleanup
  exit 1
}

cleanup() {
  log "Iniciando limpeza..."
  sync
  
  # Desmonta ESP se montado
  if mountpoint -q "${MOUNT_POINT}/boot/efi" 2>/dev/null; then
    umount "${MOUNT_POINT}/boot/efi" 2>/dev/null || true
  fi
  
  # Desmonta sistemas virtuais
  for dir in dev proc sys run; do
    if mountpoint -q "${MOUNT_POINT}/${dir}" 2>/dev/null; then
      umount -l "${MOUNT_POINT}/${dir}" 2>/dev/null || true
    fi
  done
  
  # Desmonta ZFS
  if mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
    umount -R "$MOUNT_POINT" 2>/dev/null || true
  fi
  
  # Exporta pool se existir
  if zpool list "$POOL_NAME" &>/dev/null; then
    zpool export "$POOL_NAME" 2>/dev/null || true
  fi
}

# ============================================================================
# CARREGAMENTO DE MÓDULOS
# ============================================================================

load_modules() {
  # Carrega Design System
  if [[ -f "${LIB_DIR}/../fileserver-ds.sh" ]]; then
    source "${LIB_DIR}/../fileserver-ds.sh"
  else
    echo "ERRO: Design System não encontrado" >&2
    exit 1
  fi
  
  # Carrega módulos do instalador
  local modules=(
    "firmware-detection.sh"
    "disk-detection.sh"
    "partitioning.sh"
    "zfs-setup.sh"
    "system-config.sh"
    "zbm-install.sh"
  )
  
  for module in "${modules[@]}"; do
    local module_path="${LIB_DIR}/${module}"
    if [[ -f "$module_path" ]]; then
      source "$module_path"
      log "Módulo carregado: $module"
    else
      error_exit "Módulo não encontrado: $module"
    fi
  done
}

# ============================================================================
# FLUXO DO WIZARD
# ============================================================================

step_welcome() {
  firmware_detect
  FIRMWARE_MODE=$(firmware_get_mode)
  
  ds_welcome_screen "$FIRMWARE_MODE"
  
  if ! ds_confirm "Deseja iniciar a instalação?"; then
    log "Instalação cancelada pelo usuário na tela de boas-vindas"
    exit 0
  fi
}

step_select_disk() {
  ds_disk_select_screen
  
  if ! disk_has_available; then
    error_exit "Nenhum disco disponível encontrado"
  fi
  
  local disk_list
  disk_list=$(disk_list_available)
  
  local selected
  selected=$(echo "$disk_list" | gum choose --header "Selecione o disco de destino:")
  
  # Extrai apenas o caminho do dispositivo
  SELECTED_DISK=$(echo "$selected" | awk '{print $1}')
  
  if [[ -z "$SELECTED_DISK" ]]; then
    error_exit "Nenhum disco selecionado"
  fi
  
  ds_card "$(ds_text_bold "Disco selecionado:")
$(disk_get_info "$SELECTED_DISK")" "info"
  
  log "Disco selecionado: $SELECTED_DISK"
}

step_configure() {
  ds_config_screen
  
  # Hostname
  HOSTNAME=$(ds_input "Hostname do sistema" "fileserver")
  while [[ ! "$HOSTNAME" =~ ^[a-zA-Z0-9-]+$ ]]; do
    ds_error "Hostname inválido. Use apenas letras, números e hífens."
    HOSTNAME=$(ds_input "Hostname do sistema" "fileserver")
  done
  
  # Usuário
  USERNAME=$(ds_input "Nome do usuário" "admin")
  while [[ -z "$USERNAME" ]] || [[ ! "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]]; do
    ds_error "Nome de usuário inválido"
    USERNAME=$(ds_input "Nome do usuário" "admin")
  done
  
  # Senhas
  ds_section "Segurança"
  
  USER_PASS=$(ds_password "Senha para $USERNAME")
  while [[ -z "$USER_PASS" ]]; do
    ds_error "Senha não pode ser vazia"
    USER_PASS=$(ds_password "Senha para $USERNAME")
  done
  
  ROOT_PASS=$(ds_password "Senha para root")
  while [[ -z "$ROOT_PASS" ]]; do
    ds_error "Senha não pode ser vazia"
    ROOT_PASS=$(ds_password "Senha para root")
  done
  
  log "Configuração coletada: hostname=$HOSTNAME, user=$USERNAME"
}

step_confirm() {
  ds_confirm_screen "$SELECTED_DISK" "$HOSTNAME" "$USERNAME"
  
  if ! ds_confirm "CONFIRMA A INSTALAÇÃO? TODOS OS DADOS SERÃO APAGADOS!"; then
    log "Instalação cancelada na tela de confirmação"
    exit 0
  fi
}

step_install() {
  local total_steps=6
  local current_step=0
  
  # 1. Particionamento
  ((current_step++))
  ds_install_progress_screen "$current_step" "$total_steps" "Particionando disco..."
  
  ds_spinner "Limpando disco..." bash -c "partition_wipe_disk $SELECTED_DISK"
  ds_spinner "Criando partições GPT..." bash -c "partition_create_gpt $SELECTED_DISK"
  
  local part_esp part_zfs
  part_esp=$(partition_get_esp "$SELECTED_DISK")
  part_zfs=$(partition_get_zfs "$SELECTED_DISK")
  
  ds_spinner "Formatando ESP..." bash -c "partition_format_esp $part_esp"
  
  log "Particionamento concluído: ESP=$part_esp, ZFS=$part_zfs"
  
  # 2. Configuração ZFS
  ((current_step++))
  ds_install_progress_screen "$current_step" "$total_steps" "Configurando ZFS..."
  
  ds_spinner "Criando pool ZFS..." bash -c "zfs_create_pool $part_zfs"
  ds_spinner "Criando datasets..." bash -c "zfs_create_datasets"
  
  log "Pool ZFS criado com sucesso"
  
  # 3. Cópia do sistema
  ((current_step++))
  ds_install_progress_screen "$current_step" "$total_steps" "Copiando arquivos do sistema..."
  
  ds_spinner "Sincronizando arquivos..." bash -c "
    rsync -aAXH --info=progress2 \
      --exclude={/dev/*,/proc/*,/sys/*,/tmp/*,/run/*,/mnt/*,/media/*,/lost+found,/var/log/*} \
      / ${MOUNT_POINT}/
  "
  
  # Cria diretórios necessários
  mkdir -p "${MOUNT_POINT}"/{dev,proc,sys,tmp,run,mnt,media}
  chmod 1777 "${MOUNT_POINT}/tmp"
  
  log "Cópia do sistema concluída"
  
  # 4. Configuração do sistema
  ((current_step++))
  ds_install_progress_screen "$current_step" "$total_steps" "Configurando sistema..."
  
  # Monta sistemas virtuais
  system_mount_vfs "$MOUNT_POINT"
  
  # Configura hostname
  system_set_hostname "$HOSTNAME" "$MOUNT_POINT"
  
  # Configura timezone e locales
  system_set_timezone "UTC" "$MOUNT_POINT"
  system_set_locales "$MOUNT_POINT"
  
  # Configura rede
  system_configure_network "$MOUNT_POINT"
  
  # Gera hostid
  system_generate_hostid "$MOUNT_POINT"
  
  # Cria usuário
  system_create_user "$USERNAME" "$USER_PASS" "$MOUNT_POINT"
  system_set_root_password "$ROOT_PASS" "$MOUNT_POINT"
  
  # Configura fstab
  system_configure_fstab "$POOL_NAME" "$MOUNT_POINT"
  
  log "Configuração do sistema concluída"
  
  # 5. Instalação do bootloader
  ((current_step++))
  ds_install_progress_screen "$current_step" "$total_steps" "Instalando bootloader..."
  
  # Instala ZBM
  ds_spinner "Copiando ZFSBootMenu..." bash -c "zbm_install $part_esp $MOUNT_POINT"
  
  # Configura EFI
  if [[ "$FIRMWARE_MODE" == "UEFI" ]]; then
    ds_spinner "Configurando EFI..." bash -c "zbm_configure_efi $SELECTED_DISK 2 $MOUNT_POINT"
  fi
  
  # Configura fallback boot
  zbm_setup_fallback "$part_esp" "$MOUNT_POINT"
  
  # Configura propriedades ZFS
  local hostid
  hostid=$(system_get_hostid "$MOUNT_POINT")
  zbm_configure_zfs_properties "$POOL_NAME" "$hostid"
  
  log "Bootloader instalado"
  
  # 6. Finalização
  ((current_step++))
  ds_install_progress_screen "$current_step" "$total_steps" "Finalizando instalação..."
  
  # Atualiza initramfs
  ds_spinner "Atualizando initramfs..." bash -c "system_update_initramfs $MOUNT_POINT"
  
  # Desmonta sistemas virtuais
  system_umount_vfs "$MOUNT_POINT"
  
  # Desmonta ESP
  zbm_unmount_esp "$MOUNT_POINT"
  
  # Exporta pool
  ds_spinner "Exportando pool ZFS..." bash -c "zfs_export_pool"
  
  log "Instalação finalizada com sucesso"
}

step_complete() {
  ds_complete_screen
  
  if ds_confirm "Deseja reiniciar agora?"; then
    reboot
  fi
}

# ============================================================================
# FUNÇÃO PRINCIPAL
# ============================================================================

main() {
  # Verifica se é root
  if [[ $EUID -ne 0 ]]; then
    echo "Este script deve ser executado como root" >&2
    exit 1
  fi
  
  # Verifica dependências
  if ! command -v gum &>/dev/null; then
    echo "ERRO: 'gum' não encontrado. Instalador não pode continuar." >&2
    exit 1
  fi
  
  # Configura trap para cleanup
  trap cleanup ERR SIGINT SIGTERM
  
  # Inicializa log
  mkdir -p "$(dirname "$LOG_FILE")"
  log "=== Iniciando instalador ==="
  
  # Carrega módulos
  load_modules
  
  # Executa wizard
  step_welcome
  step_select_disk
  step_configure
  step_confirm
  step_install
  step_complete
  
  log "=== Instalação concluída ==="
}

# Executa main
main "$@"
