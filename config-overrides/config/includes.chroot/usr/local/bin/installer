# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# Utilities & State (Loaded from libs/)
# ──────────────────────────────────────────────────────────────────────────────

source "${LIBS_DIR}/core-utils.sh"
source "${LIBS_DIR}/state-utils.sh"

# As traps são mantidas aqui ou movidas? trap_cleanup depende de log_line (agora em core-utils)  
# Vamos manter as traps aqui para controle do loop principal, mas elas usam log_line que é importado.  

trap_cleanup() {
    local code; code="${1-0}"
    local msg
    msg="Encerrando de forma segura ($code)."
    log_line "INFO" "$msg"

    if declare -F state_kv_set >/dev/null 2>&1; then
        state_kv_set "installer_cancelled" "1" || true
        state_kv_set "installer_cancelled_step" "${CURRENT_STEP:-unknown}" || true
    fi

    if declare -F ui_error >/dev/null 2>&1; then
        ui_error "Instalação cancelada" "Cancelamento solicitado pelo usuário (Ctrl+C). Nenhuma etapa crítica em andamento foi forçada." || true
    else
        stderr "Instalação cancelada com segurança (Ctrl+C)."
    fi

    exit "$code"
}

on_sigint() { trap_cleanup 130; }
on_sigterm() { trap_cleanup 143; }

setup_traps() {
    trap 'on_sigint' INT
    trap 'on_sigterm' TERM
}

# ──────────────────────────────────────────────────────────────────────────────
# Gum UI Components (DS v2.0 aligned) — Delegated to ui-utils.sh
# ──────────────────────────────────────────────────────────────────────────────

# Functions ui_require, ui_clear, ui_hero, ui_section, ui_card, ui_error, 
