    register_step   "post_install"   "19"    "Pós-instalação"   "Ajustes finais: apt, serviços, pacotes"   "install"   "finish"   "post-utils.sh,finalize-chroot.sh,setup-zbm-config.sh"   "post_install.sh"   "step_post_install"

