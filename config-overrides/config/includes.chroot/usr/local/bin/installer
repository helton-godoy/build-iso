    register_step   "zfs_manual"   "15"    "ZFS: Manual (Avançado)"   "VDEVs, pools, datasets e propriedades"   "zfs_strategy"   "boot"   "zfs-utils.sh"   "zfs_manual.sh"   "step_zfs_manual"

