    register_step   "zfs_auto_datasets"   "14"    "ZFS: Datasets"   "Preset padrão/servidor/custom"   "zfs_aux_setup"   "boot"   "zfs-utils.sh,disk-utils.sh,install-plan-utils.sh"   "zfs_auto_datasets.sh"   "step_zfs_auto_datasets"

