#!/usr/bin/env bash
set -u -o pipefail
install_plan=0
case ${1:-} in '') ;; --install-plan) install_plan=1;; -h|--help) printf 'Usage: bash-doctor [--install-plan]\n'; exit 0;; *) printf 'bash-doctor: unknown argument: %s\n' "$1" >&2; exit 64;; esac
missing=0
probe() {
    local command_name=$1 version_arg=${2:---version} required=$3
    if command -v "$command_name" >/dev/null 2>&1; then
        version=$($command_name "$version_arg" 2>&1 | head -n 1)
        printf 'OK      %-22s %s\n' "$command_name" "$version"
    else
        printf '%-7s %-22s not found\n' "$required" "$command_name"
        [[ $required != REQUIRED ]] || missing=1
    fi
}
probe bash --version REQUIRED
probe shellcheck --version REQUIRED
probe shfmt --version REQUIRED
probe bats --version OPTIONAL
probe bash-language-server --version OPTIONAL
if ((install_plan)); then
    cat <<'PLAN'

Installation plan (not executed):
  Debian/Ubuntu: sudo apt-get install shellcheck shfmt bats
  Homebrew:      brew install shellcheck shfmt bats-core
  Project npm:   npm install --save-dev bash-language-server bats
  shfmt via Go:  GOBIN="$HOME/.local/bin" go install mvdan.cc/sh/v3/cmd/shfmt@latest
PLAN
fi
((missing==0)) || exit 2
